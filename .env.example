# Apunta al gateway (gr-api-gateway), no a gr-user-microservice directo: es
# el unico origen que expone tanto auth como el muro (/api/v1/publicaciones).
BACKEND_API_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_UI_URL=http://localhost:3002
NEXT_PUBLIC_WALL_UI_URL=http://localhost:3003
NEXT_PUBLIC_BOOKING_UI_URL=http://localhost:3004
NEXT_PUBLIC_GATE_UI_URL=http://localhost:3005
NEXT_PUBLIC_BILLING_UI_URL=http://localhost:3007

# Origen del WebSocket de notificaciones del muro. Vacio = el mismo origen de la pagina:
# nginx (gr-infra) reenvia /api/v1/publicaciones/eventos/ws al gateway. Solo hace falta
# definirlo al correr `pnpm dev` sin nginx, p. ej. ws://localhost:4000. Se fija al compilar.
NEXT_PUBLIC_BACKEND_WS_URL=
